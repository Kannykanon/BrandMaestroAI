# Copy to .env and fill in. Never commit the filled-in .env.

# --- LLM ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Partner: Parallel Search API ---
PARALLEL_API_KEY=

# --- Database ---
POSTGRES_URI=postgresql://brandmuse:changeme@postgres:5432/brandmuse
POSTGRES_USER=brandmuse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=brandmuse

# --- Cache / queue ---
REDIS_URL=redis://redis:6379/0
RABBIT_URL=amqp://guest:guest@rabbitmq:5672//
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Celery monitoring (Flower) ---
FLOWER_USER=admin
FLOWER_PASSWORD=changeme

# --- Frontend ---
# Origin allowed by CORS, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
# Baked into the frontend at build time - must be the public API URL
VITE_API_URL=http://localhost:8000

# --- Optional: Google Cloud Agent Platform Runtime ---
# Leave AGENT_ENGINE_RESOURCE_NAME empty to run the graph in-process.
PROJECT_ID=
LOCATION=us-central1
STAGING_BUCKET=
AGENT_ENGINE_RESOURCE_NAME=

# --- Optional: Opik tracing (observability.py) ---
# Leave OPIK_API_KEY empty to disable tracing entirely (fails open, no
# behavior change). Get a key at https://www.comet.com/opik — free tier.
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=brandmuse-ai

# --- Optional: LLM request timeout / retry tuning (model.py) ---
# Defaults are 60s / 90s (synthesis) per attempt, 2 retries. Lower the
# timeout for a faster fail during a demo; raise it if legitimate large
# synthesis calls are being cut off.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_SYNTHESIS_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
