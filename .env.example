# Copy to .env and fill in. Never commit the filled-in .env.

# --- LLM ---
# Which Gemini backend to call. Same models either way — the difference is
# which account is billed and how it authenticates.
#   ai_studio  GOOGLE_API_KEY below. Separate wallet from Google Cloud, with
#              its own free-tier request cap that GCP credits cannot raise.
#   vertex_ai  Google Cloud project + Application Default Credentials
#              (`gcloud auth application-default login`). Bills to the Cloud
#              billing account, so trial credits apply. Needs PROJECT_ID.
LLM_PROVIDER=ai_studio

# Only for LLM_PROVIDER=vertex_ai. Path to a service account JSON key with
# the Vertex AI User role. Leave unset to use Application Default
# Credentials instead (gcloud auth application-default login), which works
# locally but not on hosts with no browser or gcloud.
GOOGLE_APPLICATION_CREDENTIALS=

# Retrieval embeddings. Defaults to LLM_PROVIDER if unset, which is normally
# what you want — a split leaves two accounts billed for one request.
#   ai_studio | vertex_ai | offline (local third-party model, `offline` group)
# ai_studio and vertex_ai both use text-embedding-004 at 768 dims, so switching
# between them does not require re-indexing.
EMBEDDING_PROVIDER=

# Required when LLM_PROVIDER=ai_studio. Not used on the vertex_ai path.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Partner: Parallel Search API ---
PARALLEL_API_KEY=

# --- Database ---
POSTGRES_URI=postgresql://brandmaestro:changeme@postgres:5432/brandmaestro
POSTGRES_USER=brandmaestro
POSTGRES_PASSWORD=changeme
POSTGRES_DB=brandmaestro

# --- Cache / queue ---
REDIS_URL=redis://redis:6379/0
# Celery broker. Defaults to REDIS_URL, so Redis brokers the queues as well as
# holding the Brand Brain cache, the result backend and the generation stream.
# One less service to run, which matters on hosts with no managed RabbitMQ.
# Set this to an amqp:// URL to use RabbitMQ instead; nothing else changes.
CELERY_BROKER_URL=

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Celery monitoring (Flower) ---
FLOWER_USER=admin
FLOWER_PASSWORD=changeme

# --- Frontend ---
# Origin allowed by CORS, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
# Baked into the frontend at build time - must be the public API URL
VITE_API_URL=http://localhost:8000

# --- Optional: Google Cloud Agent Platform Runtime ---
# Leave AGENT_ENGINE_RESOURCE_NAME empty to run the graph in-process.
PROJECT_ID=
LOCATION=us-central1
STAGING_BUCKET=
AGENT_ENGINE_RESOURCE_NAME=

# --- Optional: Opik tracing (observability.py) ---
# Leave OPIK_API_KEY empty to disable tracing entirely (fails open, no
# behavior change). Get a key at https://www.comet.com/opik — free tier.
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=brandmaestro-ai

# --- Optional: LLM request timeout / retry tuning (model.py) ---
# Defaults are 60s / 90s (synthesis) per attempt, 2 retries. Lower the
# timeout for a faster fail during a demo; raise it if legitimate large
# synthesis calls are being cut off.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_SYNTHESIS_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Writer/Enforcer revision rounds. Each round is two LLM calls, so this is the
# main latency lever.
#
# The default of 3 is not enough for every content type: a talent bio has
# approved on round 5. Raise it if generations are ending unapproved with
# actionable feedback still outstanding, and leave it alone if they are failing
# repeatedly for the same reason — that is not a round-count problem.
MAX_REVISION_ITERATIONS=6

# How long a client may watch a generation stream before the server gives up.
# The press-release path can run several enforcer rounds; 300 cut it off
# mid-pipeline.
MAX_STREAM_SECONDS=900
