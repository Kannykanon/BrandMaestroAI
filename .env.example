# Copy to .env and fill in. Never commit the filled-in .env.

# --- LLM ---
# Which provider adapter LLMSingleton plugs in (see model.py):
#   vertex_ai  Gemini on Google Cloud Vertex AI. Needs PROJECT_ID and
#              Application Default Credentials.
#   groq       Models served by Groq. Needs GROQ_API_KEY.
#   claude     Anthropic's Claude. Needs ANTHROPIC_API_KEY.
LLM_PROVIDER=vertex_ai
# Leave empty for the adapter's default: gemini-2.5-flash,
# llama-3.3-70b-versatile, or claude-opus-5.
LLM_MODEL=
# Per-mode overrides, for models with a smaller output limit or a different
# preferred temperature. Modes: EXTRACTION, ENFORCEMENT, SYNTHESIS, GENERATION.
# LLM_MAX_TOKENS_SYNTHESIS=16384
# LLM_TEMPERATURE_GENERATION=0.8

# vertex_ai
PROJECT_ID=
LOCATION=us-central1
# Path to a service account JSON key with the Vertex AI User role. Leave unset
# to use Application Default Credentials (gcloud auth application-default login).
GOOGLE_APPLICATION_CREDENTIALS=

# groq
GROQ_API_KEY=

# claude
ANTHROPIC_API_KEY=

# --- Embeddings (retrieval over uploaded product documents) ---
# google_vertexai | openai | google_genai | fastembed (local, `offline` extra).
# Defaults to google_vertexai with LLM_PROVIDER=vertex_ai. Groq and Claude have
# no embeddings API, so set this when using either of them.
EMBEDDING_PROVIDER=
# Only for EMBEDDING_PROVIDER=openai / google_genai.
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Leave empty for the provider default (text-embedding-3-small,
# text-embedding-004, BAAI/bge-small-en-v1.5).
EMBEDDING_MODEL=
# Required for a model not built into embedding_stategy.py. Max 2000 (pgvector
# HNSW limit). Changing the model or dimension means re-uploading documents.
EMBEDDING_DIMENSIONS=
# OpenAI-compatible embeddings endpoint, used with EMBEDDING_PROVIDER=openai.
EMBEDDING_BASE_URL=

# --- Web search: Parallel Search API ---
PARALLEL_API_KEY=

# --- Database ---
POSTGRES_URI=postgresql://brandmaestro:changeme@postgres:5432/brandmaestro
POSTGRES_USER=brandmaestro
POSTGRES_PASSWORD=changeme
POSTGRES_DB=brandmaestro

# --- Cache / queue ---
REDIS_URL=redis://redis:6379/0
# Celery broker. Defaults to REDIS_URL, so Redis brokers the queues as well as
# holding the Brand Brain cache, the result backend and the generation stream.
# One less service to run, which matters on hosts with no managed RabbitMQ.
# Set this to an amqp:// URL to use RabbitMQ instead; nothing else changes.
CELERY_BROKER_URL=

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Celery monitoring (Flower) ---
FLOWER_USER=admin
FLOWER_PASSWORD=changeme

# --- Frontend ---
# Origin allowed by CORS, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
# --- Optional: Opik tracing (observability.py) ---
# Leave OPIK_API_KEY empty to disable tracing entirely (fails open, no
# behavior change). Get a key at https://www.comet.com/opik — free tier.
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=brandmaestro-ai

# --- Optional: LLM request timeout / retry tuning (model.py) ---
# Defaults are 60s / 90s (synthesis) per attempt, 2 retries. Raise them for
# slower models (e.g. reasoning models) if legitimate calls are being cut off.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_SYNTHESIS_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Writer/Enforcer revision rounds. Each round is two LLM calls, so this is the
# main latency lever.
#
# The default of 3 is not enough for every content type: long-form pieces
# have approved on round 5. Raise it if generations are ending unapproved with
# actionable feedback still outstanding, and leave it alone if they are failing
# repeatedly for the same reason — that is not a round-count problem.
MAX_REVISION_ITERATIONS=6

# How long a client may watch a generation stream before the server gives up.
# Long-form content can run several enforcer rounds; 300 cut it off
# mid-pipeline.
MAX_STREAM_SECONDS=900
